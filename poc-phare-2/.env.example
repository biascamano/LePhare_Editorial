# Copier en .env.deploy (non versionné) et compléter. AUCUN mot de passe ici :
# le script refuse tout fichier contenant une clé PASSWORD / SECRET / TOKEN.
# Mot de passe SFTP : scripts\deploy-ovh.ps1 -EnregistrerIdentifiants (chiffré DPAPI hors dépôt).

# OVH Manager > Hébergements > le-phare.info > FTP - SSH : « Serveur FTP/SFTP » (ex. ftp.clusterXXX.hosting.ovh.net)
OVH_SFTP_HOST=
OVH_SFTP_PORT=22
# Login principal ou utilisateur FTP secondaire (préférer un secondaire restreint au dossier, voir SECURITE_DEPLOIEMENT.md)
OVH_SFTP_USER=
# Empreinte de la clé d'hôte, format WinSCP : ssh-ed25519 255 <empreinte SHA-256 base64>
# Obtention et recoupement : DEPLOIEMENT_OVH.md §4. Jamais « * ».
OVH_SFTP_HOSTKEY=

# Dossier racine du multisite test.le-phare.info, relatif à la racine du compte (un seul segment, jamais www)
OVH_REMOTE_DIR=poc-phare-2
# Chemin absolu de la racine du compte, si HomePath SFTP diffère du chemin vu par Apache (ex. /homez.XXX/<login>)
OVH_HOME_ABS=

PHARE_SITE=https://test.le-phare.info
PHARE_SOURCE=mock

# Facultatifs
OVH_HTPASSWD_FILE=
WINSCP_DIR=
