# Le Phare 2.0 - POC ({{SITE_HOST}})
# Genere par scripts/deploy-ovh.ps1 a chaque deploiement : ne pas editer en ligne.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

RewriteEngine On
# Fichiers techniques (.htaccess, .htpasswd, marqueur) : refuses avant toute autorisation.
RewriteRule (^|/)\.(ht|phare) - [F,L]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://{{SITE_HOST}}/$1 [R=301,L]

# AUTH-DEBUT
# Authentification sur HTTPS seulement : en HTTP, la redirection part avant toute demande d'identifiants.
<If "%{SERVER_PORT} == '443'">
  AuthType Basic
  AuthName "Le Phare 2.0 - prototype"
  AuthUserFile "{{HTPASSWD}}"
  Require valid-user
</If>
# AUTH-FIN
